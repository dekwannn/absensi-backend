PROJECT_NAME=GeoFace Attendance API

# MongoDB
MONGO_URI=mongodb://localhost:27017
DB_NAME=geoface_db

# JWT — buat nilai acak, contoh:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=ganti-dengan-string-acak-panjang
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Lokasi kantor
OFFICE_LAT=-8.11405
OFFICE_LON=115.13409
MAX_RADIUS=100

# Jam kerja (WITA, HH:MM)
CHECKIN_OPEN=07:00
CHECKIN_ON_TIME=08:00
CHECKIN_CLOSE=09:00
CHECKOUT_OPEN=16:30
CHECKOUT_NORMAL=17:00
CHECKOUT_CLOSE=21:00
